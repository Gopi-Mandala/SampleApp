{
  "name": "backend",
  "version": "1.0.0",
  "description": "Node.js + Express + TypeScript backend for the full-stack application",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --runInBand",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "db:migrate:undo": "sequelize-cli db:migrate:undo"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.12.0",
    "pg-hstore": "2.3.4",
    "sequelize": "6.37.3"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.13",
    "@types/jsonwebtoken": "9.0.6",
    "fast-check": "3.22.0",
    "jest": "29.7.0",
    "sequelize-cli": "6.6.2",
    "ts-jest": "29.2.5",
    "ts-node-dev": "2.0.0",
    "typescript": "5.5.4"
  }
}
